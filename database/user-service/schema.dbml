// user-service v003
// Identity and tenancy layer — owns the Kitelabs platform's user, organization,
// and session model. As of v003 also owns billing/quota and platform roles (m4-agent-cost). Federated login (Google + GitHub) lands here; downstream
// services validate sessions against this database via user-service's
// /internal/sessions/validate endpoint.
//
// Visualise at: https://dbdiagram.io (paste this file)
//
// Tenancy model
//   - `users` are global (a person exists once across the platform).
//   - `organizations` are the tenancy boundary — the unit Kitelabs sells delivery to.
//   - `workspaces` (workspace_id) live in the workspace DB; this service stores
//     workspace_id values as plain UUIDs with NO foreign key (cross-DB).
//
// Layers
//   Identity     — users, auth_identities (provider-side authentication)
//   Tenancy      — organizations, memberships, workspace_memberships
//   Onboarding   — organization_invitations
//   Sessions     — sessions (managed by alexedwards/scs/v2 + postgresstore)
//
// v002 changes (m1-unified-user):
//   - users.username added (nullable, unique case-insensitive)
//   - users.email is now unique (case-insensitive); dedup migration removes duplicate rows
//   - username backfilled from display_name for existing users on migration
//
// v003 changes (m4-agent-cost — billing, quota, platform roles):
//   - Billing: billing_plan, org_plan_assignment, model_pricing, credit_config.
//     Plans are ORG-LEVEL ONLY — there is no individual/per-user plan assignment.
//     A user's plan resolves: org plan → free.
//   - Cost ledger: turn_cost (append-only; no FK to model_pricing so unpriced
//     models still record at cost 0). credits_used = cost_usd × credit_config.usd_to_credits.
//   - Quota: user_usage_quota is keyed by (user_id, org_id) — usage is tracked
//     SEPARATELY PER ORG the user belongs to. Lazy reset (daily UTC midnight,
//     weekly Monday). org_id FK ON DELETE CASCADE.
//   - Platform roles: platform_role + platform_role_assignment (M4 ships
//     'platform_admin' only). Distinct from org-level memberships.role.

// ─────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────

Table users {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  email        text        [not null, note: 'Primary email; unique (case-insensitive). Canonical identity anchor across OAuth providers.']
  username     text        [note: 'User-chosen handle; unique (case-insensitive), nullable. Backfilled from display_name on v002 migration. Format: [a-z0-9_-], 3–30 chars.']
  display_name text
  avatar_url   text
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    `lower(email)`    [unique, name: 'idx_users_email_lower_unique']
    `lower(username)` [unique, name: 'idx_users_username_lower', note: 'Partial index: WHERE username IS NOT NULL']
  }
}

Table auth_identities {
  id             uuid        [primary key, default: `gen_random_uuid()`]
  user_id        uuid        [not null, ref: > users.id]
  provider       text        [not null, note: "'google' | 'github'"]
  provider_sub   text        [not null, note: "The IdP's stable user id (Google `sub`, GitHub user id)"]
  email          text        [note: 'Email reported by the IdP at link time']
  email_verified boolean     [note: 'Verified flag reported by the IdP']
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_sub) [unique]
    user_id
  }
}

// ─────────────────────────────────────────────
// TENANCY
// ─────────────────────────────────────────────

Table organizations {
  id         uuid        [primary key, default: `gen_random_uuid()`]
  slug       text        [unique, not null, note: 'Human-readable key, e.g. kitelabs']
  name       text        [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [unique]
  }
}

Table memberships {
  id              uuid        [primary key, default: `gen_random_uuid()`]
  user_id         uuid        [not null, ref: > users.id]
  organization_id uuid        [not null, ref: > organizations.id]
  role            text        [not null, note: "'platform_admin' | 'client_member' (M1)"]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes {
    (user_id, organization_id) [unique]
    organization_id
  }
}

Table workspace_memberships {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  user_id      uuid        [not null, ref: > users.id]
  workspace_id uuid        [not null, note: 'Workspace lives in workspace DB — plain UUID, NO foreign key (cross-DB)']
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    (user_id, workspace_id) [unique]
    workspace_id
  }
}

// ─────────────────────────────────────────────
// ONBOARDING
// ─────────────────────────────────────────────

Table organization_invitations {
  id                    uuid        [primary key, default: `gen_random_uuid()`]
  organization_id       uuid        [not null, ref: > organizations.id]
  email                 text        [not null, note: 'Matched against verified provider email at first login']
  role                  text        [not null, note: "Role granted on acceptance; same values as memberships.role"]
  invited_by_user_id    uuid        [ref: > users.id]
  workspace_ids         jsonb       [note: 'null = all workspaces in the org; otherwise an array of workspace UUIDs from workspace DB']
  created_at            timestamptz [not null, default: `now()`]
  expires_at            timestamptz
  accepted_at           timestamptz
  accepted_by_user_id   uuid        [ref: > users.id]

  indexes {
    (organization_id, `lower(email)`) [name: 'idx_org_invitations_org_email_lower']
    expires_at
  }
}

// ─────────────────────────────────────────────
// SESSIONS
// ─────────────────────────────────────────────
// Managed by alexedwards/scs/v2 + scs/postgresstore. Schema dictated by the library.
// Included here for completeness; this table is created by scs's bundled migration,
// not by application code. Do not hand-edit columns.

Table sessions {
  token  char(43)    [primary key, note: 'scs-generated random token; also the session cookie value']
  data   bytea       [not null, note: 'Gob-encoded session payload (scs internal)']
  expiry timestamptz [not null]

  indexes {
    expiry
  }
}

// ─────────────────────────────────────────────
// BILLING / QUOTA (m4-agent-cost)
// ─────────────────────────────────────────────
// Plans are ORG-LEVEL ONLY (no per-user plan). A user's caps come from their
// org's plan, resolved org → free. Usage is tracked PER (user, org).

Table billing_plan {
  id                 uuid          [primary key, default: `gen_random_uuid()`]
  name               text          [not null, unique, note: "Slug: 'free' | 'pro' | 'max'"]
  display_name       text          [not null]
  daily_credits_cap  numeric(12,2) [not null, note: '0 = unlimited']
  weekly_credits_cap numeric(12,2) [not null, note: '0 = unlimited']
  created_at         timestamptz   [not null, default: `now()`]
  updated_at         timestamptz   [not null, default: `now()`]
}

Table org_plan_assignment {
  id          uuid        [primary key, default: `gen_random_uuid()`]
  org_id      uuid        [not null, unique, ref: > organizations.id, note: 'ON DELETE CASCADE; at most one plan per org']
  plan_id     uuid        [not null, ref: > billing_plan.id]
  assigned_by uuid        [not null, ref: > users.id]
  assigned_at timestamptz [not null, default: `now()`]
  expires_at  timestamptz
}

Table model_pricing {
  model_id                  text        [primary key, note: 'Matches hermes model_catalog ids; billing rate = provider list price +5%']
  input_cost_per_mtok       numeric     [not null]
  output_cost_per_mtok      numeric     [not null]
  cache_read_cost_per_mtok  numeric     [not null]
  cache_write_cost_per_mtok numeric     [not null]
  effective_from            timestamptz [not null]
  effective_to              timestamptz
}

Table credit_config {
  id             integer [primary key, default: 1, note: 'Single row (CHECK id = 1)']
  usd_to_credits numeric [not null, note: '10000 ⇒ 1 credit = $0.0001']
}

// Append-only cost ledger; never mutated after insert. session_id/turn_id are the
// hermes-agent session/run ids (UUIDs) — no FK (cross-DB). No FK to model_pricing,
// so a turn for an unpriced model still records (at cost 0, logged for backfill).
Table turn_cost {
  id                 uuid          [primary key, default: `gen_random_uuid()`]
  user_id            uuid          [not null, ref: > users.id]
  session_id         uuid          [not null]
  turn_id            uuid          [not null]
  source_type        text          [not null, note: "e.g. 'agent_chat'"]
  source_label       text          [not null]
  task_id            uuid
  model_id           text          [not null]
  input_tokens       integer       [not null, default: 0]
  output_tokens      integer       [not null, default: 0]
  cache_read_tokens  integer       [not null, default: 0]
  cache_write_tokens integer       [not null, default: 0]
  cost_usd           numeric(12,8) [not null]
  credits_used       numeric(12,2) [not null]
  stopped            boolean       [not null, default: false]
  created_at         timestamptz   [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    (source_type, created_at)
  }
}

// One row per (user, org). Caps are NOT stored here — read live from the resolved
// billing_plan. Counters reset lazily on access (daily UTC midnight, weekly Monday).
Table user_usage_quota {
  id                  uuid          [primary key, default: `gen_random_uuid()`]
  user_id             uuid          [not null, ref: > users.id]
  org_id              uuid          [not null, ref: > organizations.id, note: 'ON DELETE CASCADE']
  plan_id             uuid          [not null, ref: > billing_plan.id]
  daily_credits_used  numeric(12,2) [not null, default: 0]
  daily_reset_at      timestamptz   [not null]
  weekly_credits_used numeric(12,2) [not null, default: 0]
  weekly_reset_at     timestamptz   [not null]
  updated_at          timestamptz   [not null, default: `now()`]

  indexes {
    (user_id, org_id) [unique]
  }
}

// ─────────────────────────────────────────────
// PLATFORM ROLES (m4-agent-cost)
// ─────────────────────────────────────────────
// Platform-scoped (internal) roles, distinct from org-level memberships.role.

Table platform_role {
  key          text        [primary key, note: "M4 ships 'platform_admin' only"]
  display_name text        [not null]
  description  text        [not null, default: '']
  created_at   timestamptz [not null, default: `now()`]
}

Table platform_role_assignment {
  id         uuid        [primary key, default: `gen_random_uuid()`]
  user_id    uuid        [not null, ref: > users.id]
  role_key   text        [not null, ref: > platform_role.key]
  granted_by uuid        [not null, ref: > users.id]
  granted_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, role_key) [unique]
    user_id
  }
}
