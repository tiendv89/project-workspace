// user-service v002
// Unified user identity — adds username, enforces email uniqueness, and
// backfills username from display_name for existing rows.
//
// Changes from v001:
//   users.username     — new nullable unique column (case-insensitive unique index)
//   users.email        — now unique (idx_users_email_lower replaced by
//                        idx_users_email_lower_unique); dedup migration runs first
//   auth_identities    — unchanged
//   all tenancy tables — unchanged
//
// Migration order (v002.sql):
//   1. ALTER TABLE users ADD COLUMN username text
//   2. CREATE UNIQUE INDEX idx_users_username_lower ON users (lower(username)) WHERE username IS NOT NULL
//   3. Backfill username from display_name (Go migration step):
//        lower(display_name), spaces → '_', strip [^a-z0-9_-], truncate 30, suffix on collision
//        Rows with null/empty display_name get username = null
//   4. Dedup users by lower(email) — keep oldest created_at, repoint auth_identities /
//        memberships / workspace_memberships, delete retired rows, delete their sessions
//   5. DROP INDEX idx_users_email_lower
//   6. CREATE UNIQUE INDEX idx_users_email_lower_unique ON users (lower(email))
//
// Visualise at: https://dbdiagram.io (paste this file)

// ─────────────────────────────────────────────
// IDENTITY
// ─────────────────────────────────────────────

Table users {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  email        text        [not null, note: 'Primary email; unique (case-insensitive). Canonical identity anchor across OAuth providers.']
  username     text        [note: 'User-chosen handle; unique (case-insensitive), nullable. Backfilled from display_name on v002 migration for existing rows. Format: [a-z0-9_-], 3–30 chars.']
  display_name text
  avatar_url   text
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    `lower(email)`    [unique, name: 'idx_users_email_lower_unique']
    `lower(username)` [unique, name: 'idx_users_username_lower', note: 'Partial index: WHERE username IS NOT NULL']
  }
}

Table auth_identities {
  id             uuid        [primary key, default: `gen_random_uuid()`]
  user_id        uuid        [not null, ref: > users.id]
  provider       text        [not null, note: "'google' | 'github'"]
  provider_sub   text        [not null, note: "The IdP's stable user id (Google `sub`, GitHub user id)"]
  email          text        [note: 'Email reported by the IdP at link time']
  email_verified boolean     [note: 'Verified flag reported by the IdP']
  created_at     timestamptz [not null, default: `now()`]

  indexes {
    (provider, provider_sub) [unique]
    user_id
  }
}

// ─────────────────────────────────────────────
// TENANCY
// ─────────────────────────────────────────────

Table organizations {
  id         uuid        [primary key, default: `gen_random_uuid()`]
  slug       text        [unique, not null, note: 'Human-readable key, e.g. kitelabs']
  name       text        [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    slug [unique]
  }
}

Table memberships {
  id              uuid        [primary key, default: `gen_random_uuid()`]
  user_id         uuid        [not null, ref: > users.id]
  organization_id uuid        [not null, ref: > organizations.id]
  role            text        [not null, note: "'platform_admin' | 'client_member' (M1)"]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]

  indexes {
    (user_id, organization_id) [unique]
    organization_id
  }
}

Table workspace_memberships {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  user_id      uuid        [not null, ref: > users.id]
  workspace_id uuid        [not null, note: 'Workspace lives in workspace DB — plain UUID, NO foreign key (cross-DB)']
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    (user_id, workspace_id) [unique]
    workspace_id
  }
}

// ─────────────────────────────────────────────
// ONBOARDING
// ─────────────────────────────────────────────

Table organization_invitations {
  id                    uuid        [primary key, default: `gen_random_uuid()`]
  organization_id       uuid        [not null, ref: > organizations.id]
  email                 text        [not null, note: 'Matched against verified provider email at first login']
  role                  text        [not null, note: "Role granted on acceptance; same values as memberships.role"]
  invited_by_user_id    uuid        [ref: > users.id]
  workspace_ids         jsonb       [note: 'null = all workspaces in the org; otherwise an array of workspace UUIDs from workspace DB']
  created_at            timestamptz [not null, default: `now()`]
  expires_at            timestamptz
  accepted_at           timestamptz
  accepted_by_user_id   uuid        [ref: > users.id]

  indexes {
    (organization_id, `lower(email)`) [name: 'idx_org_invitations_org_email_lower']
    expires_at
  }
}

// ─────────────────────────────────────────────
// SESSIONS
// ─────────────────────────────────────────────
// Managed by alexedwards/scs/v2 + scs/postgresstore. Schema dictated by the library.
// Included here for completeness; this table is created by scs's bundled migration,
// not by application code. Do not hand-edit columns.

Table sessions {
  token  char(43)    [primary key, note: 'scs-generated random token; also the session cookie value']
  data   bytea       [not null, note: 'Gob-encoded session payload (scs internal)']
  expiry timestamptz [not null]

  indexes {
    expiry
  }
}
