// hermes-agent v001
// Session and message store for the workflow gateway (hermes-agent fork).
// Visualise at: https://dbdiagram.io (paste this file)
//
// Source of truth: hermes-agent/workflow_gateway/migrations/001_initial_schema.sql
// ORM models:     hermes-agent/workflow_gateway/db/models.py
// Store layer:    hermes-agent/workflow_gateway/db/store.py
//
// Design notes:
//   workspace_id / feature_id are TEXT slugs (e.g. "my-workspace", "m3-agent-chat-v2"),
//   not UUIDs. Cross-DB reference to the workspace database — no FK enforced.
//   session_id format: "sess_<32 hex chars>" (generated by secrets.token_hex(16)).
//   All timestamps are DOUBLE PRECISION (Unix epoch seconds), matching hermes internals.
//
// Cross-service references (no FK enforced):
//   sessions.workspace_id → workspace-db workspaces.slug
//   sessions.feature_id   → workspace-db workspace_features.feature_name

// ─────────────────────────────────────────────
// MIGRATION TRACKER
// ─────────────────────────────────────────────

Table schema_migrations {
  filename   text              [primary key]
  applied_at double_precision  [not null]
}

// ─────────────────────────────────────────────
// CORE
// ─────────────────────────────────────────────

Table sessions {
  id                  text             [primary key, note: '"sess_<32 hex>" — generated by secrets.token_hex(16)']
  source              text             [not null, note: 'Always "hermes-agent" for gateway-created sessions']
  user_id             text
  workspace_id        text             [not null, default: '', note: 'Slug — cross-DB ref to workspaces.slug; no FK']
  feature_id          text             [not null, default: '', note: 'Slug — cross-DB ref to workspace_features.feature_name; no FK']
  model               text
  model_config        text
  system_prompt       text
  parent_session_id   text             [ref: > sessions.id, note: 'Optional parent for forked sessions']
  started_at          double_precision [not null]
  ended_at            double_precision
  end_reason          text
  last_active_at      double_precision [not null]
  is_active           boolean          [not null, default: true]
  message_count       integer          [not null, default: 0]
  tool_call_count     integer          [not null, default: 0]
  input_tokens        integer          [not null, default: 0]
  output_tokens       integer          [not null, default: 0]
  cache_read_tokens   integer          [not null, default: 0]
  cache_write_tokens  integer          [not null, default: 0]
  reasoning_tokens    integer          [not null, default: 0]
  api_call_count      integer          [not null, default: 0]
  estimated_cost_usd  double_precision
  actual_cost_usd     double_precision
  cost_status         text
  cost_source         text
  pricing_version     text
  billing_provider    text
  billing_base_url    text
  billing_mode        text
  cwd                 text
  title               text             [note: 'Auto-set from first user message (truncated to 60 chars) by m3-agent-chat-v2']
  archived            boolean          [not null, default: false]
  metadata            jsonb            [not null, default: '{}']

  indexes {
    source
    started_at [name: 'idx_sessions_started']
    user_id    [name: 'idx_sessions_user']
    (workspace_id, feature_id, started_at) [note: 'Added for session history list query in m3-agent-chat-v2']
  }
}

Table messages {
  id                     bigserial        [primary key]
  session_id             text             [not null, ref: > sessions.id, note: 'ON DELETE CASCADE']
  role                   text             [not null, note: 'user | assistant | tool']
  content                text
  tool_call_id           text
  tool_calls             text             [note: 'JSON-serialised tool call list']
  tool_name              text
  finish_reason          text
  reasoning              text
  reasoning_content      text
  reasoning_details      text
  codex_reasoning_items  text
  codex_message_items    text
  token_count            integer
  platform_message_id    text
  observed               boolean          [not null, default: false]
  active                 boolean          [not null, default: true, note: 'false = soft-deleted / pruned from context window']
  created_at             double_precision [not null]

  indexes {
    (session_id, created_at)        [name: 'idx_messages_session']
    (session_id, active, created_at) [name: 'idx_messages_session_active']
  }
}
