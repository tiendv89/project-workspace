// workspace-data-backend v004
// Workspace data backend — GitHub Sync, Read API, Go-orchestrator ownership, and model policy
// Visualise at: https://dbdiagram.io (paste this file)
//
// This snapshot is reconciled to the ACTUAL physical schema produced by
// workflow-backend/migrations 00001–00020. Source of truth = workflow-backend/migrations.
//
// Identity model (post 00009/00010/00011/00016/00018):
//   feature_id, task_id are SURROGATE UUIDs. feature_id now has a standalone UNIQUE
//   constraint (00016), making it the sole FK target for workspace_tasks and
//   workspace_feature_documents. The surrogate id is the internal row key only.
//   Human slugs live in feature_name / task_name.
//
// Writers of the CORE tables:
//   adapter-service  — GitHub YAML→DB sync; writes `owner IS NULL` (legacy/TS) rows
//   go-orchestrator  — workflow-orchestrator; writes `owner = 'go'` rows directly
//   api-service      — read side only; queries core tables, never writes
//
// v004 changes (over v003):
//   - workspace_features.feature_id: standalone UNIQUE added (00016)
//   - workspace_tasks.feature_id FK re-pointed to workspace_features.feature_id (00016)
//   - workspace_feature_documents.feature_id FK re-pointed + rows data-fixed (00018)
//   - workspace_activity_events.feature_id: data-fixed for read consistency (00018, no FK added)
//   - workspace_features.init_pr_url, init_pr_merged added (00017, feature-initialization-compatible)
//   - workspace_repos.repo_url added (00019)
//   - models + workspace_model_policies tables added (00020)
//
// Cross-service references:
//   workspaces.organization_id → user-service organizations.id
//     Plain UUID; NO foreign key (cross-database).

// ─────────────────────────────────────────────
// CORE
// ─────────────────────────────────────────────

Table workspaces {
  id                 uuid        [primary key, default: `gen_random_uuid()`]
  organization_id    uuid        [not null, note: 'Owning organization. Lives in user-service DB — plain UUID, NO foreign key (cross-DB). NOT NULL since 00014.']
  slug               text        [unique, not null]
  name               text        [not null]
  management_repo_id text        [not null]
  branch_pattern     text
  slack_channel_id   text        [note: 'Added 00012 — Slack notification channel for this workspace.']
  created_at         timestamptz [not null, default: `now()`]
  updated_at         timestamptz [not null, default: `now()`]

  indexes {
    slug [unique]
    organization_id
    updated_at
  }
}

Table workspace_repos {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id uuid        [not null, ref: > workspaces.id]
  repo_id      text        [not null, note: 'Logical repo id, e.g. workflow-backend; matches repos[].id in workspace.yaml']
  base_branch  text
  repo_url     text        [note: 'GitHub URL for this repo (00019). Nullable.']
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, repo_id) [unique]
    workspace_id
  }
}

Table workspace_features {
  id             uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id   uuid        [not null, ref: > workspaces.id]
  feature_id     uuid        [not null, default: `gen_random_uuid()`, note: 'Surrogate UUID (00010). Standalone UNIQUE added 00016 — sole FK target for tasks/documents. Human slug lives in feature_name.']
  feature_name   text        [not null, note: 'Slug, e.g. executor-self-briefing (00010).']
  title          text        [not null]
  feature_status text
  current_stage  text
  next_action    text
  stages         jsonb       [note: 'Full parsed stages object from status.yaml']
  source_path    text        [note: 'v003: relaxed to NULLABLE. Set for legacy (owner IS NULL) rows; NULL for owner=go (DB-native, no YAML origin).']
  source_hash    text
  owner          text        [note: 'v003: NULL/absent = legacy git/YAML (TS orchestrator + adapter sync); "go" = DB-native (Go orchestrator). No backfill — existing rows stay NULL.']
  init_pr_url    text        [note: '(00017) URL of the initialization PR created for this feature. Nullable until a PR is provisioned.']
  init_pr_merged boolean     [not null, default: false, note: '(00017) True when the init PR has been merged on GitHub. Defaults to false.']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, feature_name) [unique]
    (workspace_id, feature_id) [unique]
    feature_id [unique]
    (workspace_id, feature_status)
    (workspace_id, current_stage)
    (workspace_id, owner)
  }
}

Table workspace_feature_documents {
  id            uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id  uuid        [not null, ref: > workspaces.id]
  feature_id    uuid        [not null, ref: > workspace_features.feature_id, note: 'UUID FK → workspace_features.feature_id, ON DELETE CASCADE (00018 re-pointed from .id; existing rows data-fixed).']
  feature_name  text        [not null, note: 'Feature slug (00009).']
  document_type text        [not null, note: 'product_spec | technical_design | tasks_md | status_yaml']
  source_path   text        [not null, note: 'Relative path in repo.']
  url           text        [note: 'GitHub web URL to the document file']
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, feature_id, document_type) [unique]
    (workspace_id, feature_id)
  }
}

Table workspace_tasks {
  id             uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id   uuid        [not null, ref: > workspaces.id]
  feature_id     uuid        [not null, ref: > workspace_features.feature_id, note: 'UUID FK → workspace_features.feature_id (re-pointed 00016), ON DELETE CASCADE.']
  feature_name   text        [not null, note: 'Feature slug (00009).']
  task_id        uuid        [not null, default: `gen_random_uuid()`, note: 'Surrogate UUID (00010). The human id (e.g. T1) lives in task_name.']
  task_name      text        [not null, note: 'e.g. T1 (00010).']
  title          text        [not null]
  repo           text        [note: 'Implementation repo id; matches workspace_repos.repo_id']
  status         text
  depends_on     jsonb       [not null, note: "Array of task slugs; [] when none. Default '[]'."]
  blocked_reason text
  branch         text
  execution      jsonb
  pr             jsonb
  workspace_pr   jsonb
  source_path    text        [note: 'v003: relaxed to NULLABLE. Set for legacy rows; NULL for owner=go.']
  source_hash    text
  owner          text        [note: 'v003: denormalized from the owning feature (NULL = legacy/TS, "go" = Go orchestrator). Kept in sync by the writer; enables the eligibility scan without a join.']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, feature_id, task_name) [unique]
    (workspace_id, task_id) [unique]
    (workspace_id, feature_id)
    (workspace_id, status)
    (workspace_id, repo)
    (workspace_id, owner, status)
  }
}

Table workspace_activity_events {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id uuid        [not null, ref: > workspaces.id]
  scope_type   text        [not null, note: 'workspace | feature | task']
  feature_id   uuid        [note: 'UUID (00009), nullable. No FK — denormalized timeline. Data-fixed in 00018 to use business-key feature_id.']
  feature_name text        [note: 'Slug (00009), nullable.']
  task_id      uuid        [note: 'UUID (00009), nullable.']
  task_name    text        [note: 'nullable.']
  action       text
  actor        text
  occurred_at  text        [note: 'Raw parseable timestamp from source event']
  note         text
  sequence     integer     [not null, note: 'Position in source array for stable ordering']
  raw_event    jsonb       [not null]
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, feature_id, task_id, sequence) [unique, note: 'partial: WHERE feature_id IS NOT NULL AND task_id IS NOT NULL']
    (workspace_id, feature_id, sequence) [unique, note: 'partial: WHERE feature_id IS NOT NULL AND task_id IS NULL']
    (workspace_id, scope_type, occurred_at)
    (workspace_id, feature_id, occurred_at)
    (workspace_id, feature_id, task_id, occurred_at)
  }
}

// ─────────────────────────────────────────────
// GITHUB ADAPTER  (removable as a unit)
// ─────────────────────────────────────────────

Table workspace_github_sources {
  id             uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id   uuid        [not null, ref: > workspaces.id]
  repo_url       text        [not null, note: 'GitHub repository URL']
  repo_owner     text        [not null]
  repo_name      text        [not null]
  default_branch text        [note: 'Branch used for sync; defaults to main when absent']
  created_at     timestamptz [not null, default: `now()`]
  updated_at     timestamptz [not null, default: `now()`]

  indexes {
    workspace_id [unique]
    (repo_owner, repo_name) [unique]
  }
}

Table workspace_sync_runs {
  id            uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id  uuid        [not null, ref: > workspaces.id]
  trigger       text        [not null, note: 'import | manual | webhook_base | webhook_feature | webhook_task_queue']
  branch        text        [note: 'branch that triggered the sync; null for import and manual']
  feature_id    uuid        [ref: > workspace_features.id, note: 'UUID FK (00011), ON DELETE SET NULL, nullable.']
  task_id       uuid        [ref: > workspace_tasks.id, note: 'UUID FK (00011), ON DELETE SET NULL, nullable.']
  mode          text        [not null, note: 'full_reconciliation | targeted']
  status        text        [not null, note: "running | success | partial | failed | skipped. Default 'running'."]
  commit_sha    text        [note: 'Git commit SHA at time of full reconciliation; null for targeted runs']
  changed_paths jsonb       [note: 'file paths synced; populated for targeted runs']
  started_at    timestamptz [not null, default: `now()`]
  finished_at   timestamptz
  error_code    text
  error_message text
  metadata      jsonb       [note: 'counts, warnings, skipped files']

  indexes {
    (workspace_id, started_at)
    (workspace_id, trigger)
    (workspace_id, status)
    (workspace_id, feature_id)
    (workspace_id, task_id)
  }
}

// ── Task sync queue ───────────────────────────────────────
// NOT a database table — backed by asynq + Redis.
// Task payload: { WorkspaceID, FeatureID, TaskID }
// Dedup: asynq.Unique(24h) — one pending item per payload key.
// Clear on full reconciliation: inspector.DeleteAllPendingTasks("task-sync")
// Monitor via asynqmon UI. REDIS_URL required in environment.

// ─────────────────────────────────────────────
// MODEL POLICY  (added 00020)
// ─────────────────────────────────────────────

Table models {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  model_id     text        [not null, unique, note: 'Claude model string identifier, e.g. claude-sonnet-4-6 (00020). Seeded: Haiku 4.5, Sonnet 4.6, Opus 4.8.']
  display_name text
  active       boolean     [not null, default: true]
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    model_id [unique]
  }
}

Table workspace_model_policies {
  id           uuid        [primary key, default: `gen_random_uuid()`]
  workspace_id uuid        [not null, ref: > workspaces.id]
  phase        text        [not null, note: 'Workflow phase this policy applies to (00020).']
  model_id     uuid        [not null, ref: > models.id]
  is_default   boolean     [not null, default: false, note: 'True = default model for this phase. Partial unique enforces at most one per (workspace_id, phase). (00020)']
  created_at   timestamptz [not null, default: `now()`]
  updated_at   timestamptz [not null, default: `now()`]

  indexes {
    (workspace_id, phase, model_id) [unique]
    (workspace_id, phase) [unique, note: 'partial: WHERE is_default = true']
  }
}
