WORKSPACE_ROOT=
WORKSPACE_ID=workspace
WORKSPACE_NAME=workspace

GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

GITHUB_ACCOUNT=
SSH_KEY_PATH=~/.ssh/your_key_name

# Base branches are per-repo, declared in workspace.yaml (repos[].base_branch)
SKIP_STAGING=false

WORKFLOW_LOCAL_PATH=
DIGITAL_FACTORY_UI_LOCAL_PATH=
RAG_SERVICE_LOCAL_PATH=
WORKFLOW_BACKEND_LOCAL_PATH=
USER_SERVICE_LOCAL_PATH=       # Required once user-service GitHub repo (P1) is created

# Autonomous task orchestrator settings
REVIEWER_MAX_CYCLES=3
EXECUTOR_MAX_RETRIES=3
SLACK_WEBHOOK_URL=

# Autonomous feature reviewer settings
GITHUB_TOKEN=                    # PAT for the executor/impl bot account (repo scope)
REVIEWER_GITHUB_TOKEN=           # PAT for dedicated reviewer GitHub account (repo scope)
REVIEWER_GIT_AUTHOR_NAME=        # e.g. "ZBot Reviewer"
REVIEWER_GIT_AUTHOR_EMAIL=       # e.g. "reviewer@example.com"
FEATURE_REVIEW_INTERVAL=20       # poll cycles between drift checks (default 20, ~10 min at 30s poll)
