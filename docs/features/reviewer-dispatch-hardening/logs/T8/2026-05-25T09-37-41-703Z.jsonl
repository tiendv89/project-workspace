+/**
+ * Read the task title from the task YAML in the management repo.
+ * Returns undefined when the file doesn't exist, is unparseable, or has no title field.
+ */
+function readTaskTitle(mgmtDir: string, featureId: string, taskId: string): string | undefined {
+  try {
+    const yamlPath = join(mgmtDir, "docs", "features", featureId, "tasks", `${taskId}.yaml`);
+    if (!existsSync(yamlPath)) return undefined;
+    const content = readFileSync(yamlPath, "utf-8");
+    const match = content.match(/^title:\s*(.+)$/m);
+    if (!match) return undefined;
+    // Strip surrounding quotes (single or double) if present
+    return match[1].trim().replace(/^["']|["']$/g, "");
+  } catch {
+    return undefined;
+  }
+}
