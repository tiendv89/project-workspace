+/**
+ * Integration tests for Hermes executor audit building and result augmentation.
+ *
+ * The auditable data is constructed inside main() at lines 788-814 and 843-848,
+ * which are not directly testable without spawning a full Hermes process.
+ * These tests verify the building and augmentation logic by mirroring the
+ * same construction patterns.
+ *
+ * Covers:
+ *   1. HermesExecutorAudit minimum shape (always present, minimum {})
+ *   2. ExecutorAudit always carries { hermes: { ... } }
+ *   3. Short-circuit augmentation: Hermes wrote in_review result → executor_audit merged
+ *   4. Short-circuit augmentation: preserves existing executor_audit.* keys
+ *   5. Short-circuit augmentation: adds hermes when executor_audit exists but lacks hermes
+ *   6. No_changes fallback: blocked result always carries executor_audit
+ */
+
+import { describe, it, expect } from "vitest";
+import type {
+  ExecutorAudit,
+  HermesExecutorAudit,
+  ExecutorResult,
+  ClaudeExecutorAudit,
+} from "@workflow/runtime-abi";
+
+// ── Fixtures ──────────────────────────────────────────────────────────────────
+
+function makeHermesAudit(turns: number | undefined): HermesExecutorAudit {
+  return turns !== undefined && turns > 0 ? { turns } : {};
+}
+
+function makeExecutorAudit(hermesAudit: HermesExecutorAudit): ExecutorAudit {
+  return { hermes: hermesAudit };
+}
+
+// ── Short-circuit augmentation (mirrors lines 788-816) ────────────────────────
+
+/**
+ * Mirror of the augmentation logic at index.ts:809-814.
+ * When Hermes writes a valid in_review result.json and the wrapper detects it,
+ * the wrapper augments the result with executor_audit before writing back.
+ */
+function augmentHermesResult(
+  raw: ExecutorResult & { pr_url?: string },
+  executorAudit: ExecutorAudit,
+  hermesAudit: HermesExecutorAudit,
+): ExecutorResult & { pr_url?: string } {
+  // Short-circuit condition (line 804-808):
+  // Hermes wrote result.json with terminal_status="in_review" AND a pr_url.
+  // The augmentation at lines 809-814 merges executor_audit.
+  if (raw.terminal_status === "in_review") {
+    if (!raw.executor_audit) {
+      raw.executor_audit = executorAudit;
+    } else if (!raw.executor_audit.hermes) {
+      raw.executor_audit.hermes = hermesAudit;
+    }
+  }
+  return raw;
+}
+
+// ── No-changes fallback (mirrors lines 843-848) ───────────────────────────────
+
+/**
+ * Mirror of the no_changes result write at index.ts:843-848.
+ * When Hermes exits without file changes, the wrapper writes a blocked result
+ * that always includes executor_audit.
+ */
+function buildNoChangesResult(executorAudit: ExecutorAudit): ExecutorResult {
+  return {
+    terminal_status: "blocked",
+    blocked_reason: "no_changes",
+    blocked_suggestion:
+      "Hermes exited without making any file changes. Re-run with a clearer briefing or more iterations.",
+    executor_audit: executorAudit,
+  };
+}
+
+// ── HermesExecutorAudit minimum shape ──────────────────────────────────────────
