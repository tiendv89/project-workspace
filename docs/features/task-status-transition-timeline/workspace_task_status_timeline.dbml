Table workspace_task_status_timeline {
  id            uuid [pk, default: `gen_random_uuid()`]
  workspace_id  uuid [not null, ref: > workspaces.id]
  feature_id    uuid [not null, ref: > workspace_features.id]
  task_id       uuid [not null, ref: > workspace_tasks.id]
  task_name     text [not null]
  status        text [not null]
  started_at    timestamptz [not null]
  ended_at      timestamptz
  created_at    timestamptz [not null, default: `now()`]

  Indexes {
    (task_id) [unique, where: "ended_at IS NULL", name: "uq_task_timeline_one_active"]
    (task_id, started_at) [name: "idx_task_timeline_time"]
  }
}
